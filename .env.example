# Pilot application configuration. Never commit real secrets.
APP_ENV=development
PUBLIC_APP_NAME=Rendezvue
PUBLIC_BASE_URL=http://localhost:4173

# Browser-safe backend proof configuration.
# The public Hugging Face pilot remains local-demo.
RENDEZVUE_BACKEND_MODE=local-demo
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RENDEZVUE_AUTH_REDIRECT_URL=http://127.0.0.1:4174/

# Protected GitHub environment values for remote migration deployment.
# Store these only as GitHub environment secrets, never in a local browser build.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Local Supabase CLI provider examples. Real values belong in an ignored .env file.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Future external providers. Never expose these values to the browser.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
AGE_ASSURANCE_API_KEY=
LIVENESS_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
