# Repository-local concept configuration. Never commit real secrets.
APP_ENV=development
PUBLIC_APP_NAME=Rendezvue
PUBLIC_BASE_URL=http://localhost:4173

# Browser-safe Cloudflare Pages staging configuration.
# Configure these in the Cloudflare Pages project for production and preview builds.
RENDEZVUE_BACKEND_MODE=supabase-proof
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
RENDEZVUE_STAGING_URL=https://rendezvue-private-preview.pages.dev/

# Protected GitHub environment values for remote migration and provider configuration.
# Store these only as GitHub environment secrets, never in a browser build.
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Local Supabase CLI provider examples. Real values belong in an ignored .env file.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# Future external providers. Never expose these values to the browser.
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=
AGE_ASSURANCE_API_KEY=
LIVENESS_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_WEBHOOK_SECRET=
